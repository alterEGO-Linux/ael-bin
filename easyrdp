#!/usr/bin/env bash
# easyrdp - simple RDP wrapper.
# author  : Pascal Malouin (https://github.com/EGOUID0)
# project : https://github.com/alterEGO-Linux/ael-bin
# created : 2026-04-23

set -euo pipefail

# |--( configuration directory )

__PRIVATE="${HOME}/.config/ael/easyrdp/private"
mkdir -p "${__PRIVATE}"

# |--( ael-bashlib )

if [[ -z "${AEL_BASHLIB:-}" ]]; then
    printf '%s\n' \
        'Warning: $AEL_BASHLIB is not set.' \
        '' \
        'The recommended location is:' \
        '  ~/.local/share/ael/ael-bashlib' \
        '' \
        'Set it with:' \
        '  export AEL_BASHLIB="$HOME/.local/share/ael/ael-bashlib"' \
        ''
fi

bashlib_dir="${AEL_BASHLIB:-$HOME/.local/share/ael/ael-bashlib}"

if [[ ! -d "$bashlib_dir" ]]; then
    printf '%s\n' \
        'Error: AEL//BashLib is required but could not be found.' \
        '' \
        'Expected location:' \
        "  $bashlib_dir" \
        '' \
        'Installation instructions:' \
        '  https://github.com/alterEGO-Linux/ael-documentation/blob/main/components/ael-bashlib/INDEX.md' \
        '' >&2

    exit 1
fi

source "${bashlib_dir}/ael"
import applications messages

check_applications xfreerdp3 || exit 1

# |--( help )-----------------------------------------------------------------|

usage() {
    cat <<EOF
===============================================================================
[+] easyrdp - Simple RDP wrapper
===============================================================================

Usage:
  easyrdp
  easyrdp -c CONFIG_FILE
  easyrdp --config CONFIG_FILE
  easyrdp -h|--help

Options:
  -c, --config FILE
      Use the specified configuration file.

      If no configuration file is specified, AEL//Fuzz is used to
      select one interactively.

  -h, --help
      Show this help and exit.

CONFIG_FILE example:

---
user="a_regular_user"
domain="MyDomain"
server="my_domain.com"
password='password1'

gateway_server="remote.gateway.ca"
gateway_user="gateway_user"
gateway_password='gateway_password'

clipboard="yes"
sound="yes"
usb="no"
fullscreen="yes"
---

The gateway information is only needed if a gateway is used.

Full documentation:
  <https://github.com/alterEGO-Linux/ael-documentation/blob/main/components/ael-bin/INDEX.md>
-------------------------------------------------------------------------------
EOF
}

# |-( config search )
# | Search configuration using ael-fuzz.
# | [todo] allow other means of search in the future.

search_config() {
    check_applications ael-fuzz || exit 1

    __CONFIG_FILE="$(
        find "${__PRIVATE}/" -maxdepth 1 -type f |
            ael-fuzz --frontend quickshell
    )"

    # | Search cancelled or returned nothing.
    [[ -n "${__CONFIG_FILE}" ]] || exit 0
}


# |--( arguments )------------------------------------------------------------|

__CONFIG_FILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;

        -c|--config)
            if [[ -z "${2:-}" ]]; then
                message error "easyrdp - $1 requires a config file."
                exit 1
            fi

            __CONFIG_FILE="$2"
            shift 2
            ;;

        *)
            message error "easyrdp - Unknown argument: $1"
            usage
            exit 1
            ;;
    esac
done

# |--( configuration )--------------------------------------------------------|

# | Interactive choice if no configuration file given.
if [[ -z "${__CONFIG_FILE}" ]]; then
    search_config
fi

# | Make sure the selected/provided configuration exists.
if [[ ! -f "${__CONFIG_FILE}" ]]; then
    message error "easyrdp - Cannot find config file: ${__CONFIG_FILE}"
    exit 1
fi

# |-( default option values )

clipboard="yes"
sound="yes"
usb="no"
fullscreen="no"
reconnect=20

# |-( load configuration )

. "${__CONFIG_FILE}"

# |-( required values )

: "${user:?missing user in config}"
: "${domain:?missing domain in config}"
: "${server:?missing server in config}"

# |--( command builder )------------------------------------------------------|

cmd=(
    xfreerdp3
    "/u:${user}"
    "/d:${domain}"
    "/v:${server}"
)

[[ -n "${password:-}" ]] && cmd+=("/p:${password}")

if [[ -n "${gateway_server:-}" ]]; then
    : "${gateway_user:?missing gateway_user in config}"

    gateway="g:${gateway_server},u:${gateway_user}"

    [[ -n "${gateway_password:-}" ]] && gateway+=",p:${gateway_password}"

    cmd+=("/gateway:${gateway}")
fi

[[ "${clipboard}" == "yes" ]] && cmd+=("/clipboard")
[[ "${sound}" == "yes" ]] && cmd+=("/sound")
[[ "${usb}" == "yes" ]] && cmd+=("/usb:auto")
[[ "${fullscreen}" == "yes" ]] && cmd+=("/f")
[[ -n "${reconnect}" ]] && cmd+=(
    "+auto-reconnect"
    "/auto-reconnect-max-retries:${reconnect}"
)

exec "${cmd[@]}"
